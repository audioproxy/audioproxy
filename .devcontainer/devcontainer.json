{
  "name": "audio_proxy",
  // A compose project rather than a bare Dockerfile build since add-s3-client:
  // the :garage suite needs a real S3-compatible store alongside the app, and a
  // fake that verified signatures would only be a second SigV4 implementation
  // agreeing with the first. docker-compose.yml has the rest of the reasoning,
  // including why the store publishes no ports.
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  // Start and stop both services together. The store stops when its worktree stops.
  "runServices": ["app", "garage"],
  "workspaceFolder": "/workspaces/audio_proxy",
  "remoteUser": "dev",
  // Deps + compile. Runs once, when the container is first created.
  "postCreateCommand": "bin/agent-setup",
  // The workspace mount, DEVCONTAINER=1 and the published listener port all
  // moved into docker-compose.yml, which is where compose expects them.
  // `appPort` in particular has no meaning for a compose-backed devcontainer.
  "customizations": {
    "vscode": {
      "extensions": ["JakeBecker.elixir-ls", "editorconfig.editorconfig"]
    }
  }
}
