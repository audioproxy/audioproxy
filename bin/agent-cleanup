#!/usr/bin/env bash
#
# bin/agent-cleanup — Tear down this worktree's container before wt removes it.
#
# There is no per-branch state to drop: the app holds no database and the
# variant cache lives in S3 under content-addressed keys shared by every
# worktree. So all this does is remove the worktree's devcontainer, which
# would otherwise linger after the directory is gone.
#
# "The devcontainer" is a compose project, not a container. The devcontainer CLI
# labels only the service it attaches to — `devcontainer.local_folder` lands on
# `app` and on nothing else — so selecting by that label alone tore down `app`
# and left the `minio` sidecar running against a directory that no longer
# existed. Every worktree removal stranded one, plus the project's network;
# `add-image-license-compliance` left a MinIO up for 16 hours before anyone
# looked. The label both services do carry is the compose project's
# `working_dir`, which is derived from the path rather than from a munged
# project name, so it needs no guessing about how the CLI spells things.
#
# Invoked by wt's [pre-remove] hook.

set -euo pipefail

if [ "${DEVCONTAINER:-}" = "1" ]; then
  echo "Error: bin/agent-cleanup runs on the host, not inside the container." >&2
  exit 1
fi

WORKSPACE_FOLDER="$(cd "$(dirname "$0")/.." && pwd)"

echo "==> Removing devcontainer for $(basename "$WORKSPACE_FOLDER")"

# Two filters, unioned: the first finds the attached service the way it always
# has, the second finds every service in the same compose project. Either alone
# is a container this worktree owns, and both are scoped by this worktree's own
# path, so a parallel session's containers cannot match. Docker ANDs multiple
# --filter arguments, hence two queries rather than one.
containers="$( { docker ps -aq \
    --filter "label=devcontainer.local_folder=$WORKSPACE_FOLDER"
  docker ps -aq \
    --filter "label=com.docker.compose.project.working_dir=$WORKSPACE_FOLDER/.devcontainer"
  } 2>/dev/null | sort -u || true)"

if [ -n "$containers" ]; then
  # Read the project off the containers before removing them — afterwards there
  # is nothing left to ask, and the network outlives its services.
  # shellcheck disable=SC2086
  projects="$(docker inspect $containers \
    --format '{{index .Config.Labels "com.docker.compose.project"}}' 2>/dev/null \
    | grep -v '^$' | sort -u || true)"

  # shellcheck disable=SC2086
  docker rm --force --volumes $containers >/dev/null
  echo "==> Removed $(printf '%s\n' "$containers" | wc -l | tr -d ' ') container(s)"

  for project in $projects; do
    networks="$(docker network ls -q \
      --filter "label=com.docker.compose.project=$project" 2>/dev/null || true)"
    if [ -n "$networks" ]; then
      # shellcheck disable=SC2086
      docker network rm $networks >/dev/null 2>&1 || true
      echo "==> Removed the $project network"
    fi
  done
else
  echo "==> No container found; nothing to do"
fi
