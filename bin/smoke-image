#!/usr/bin/env ruby
# frozen_string_literal: true

# Container smoke suite: builds the release image and exercises it as an
# operator would, from outside. Everything here is a claim the unit and
# integration suites cannot make, because it is about the artifact rather than
# the code — that the release boots, that it renders through the ffmpeg the
# image ships, that a bad AP_ variable kills the container, and that SIGTERM
# during a render is a clean exit.
#
#   bin/smoke-image                 # build, then run every check
#   SKIP_BUILD=1 bin/smoke-image    # reuse the tagged image
#   IMAGE=ghcr.io/... bin/smoke-image
#
# Requires docker and curl on PATH. ffmpeg is NOT required on the host: the
# fixture is generated with the image's own ffmpeg, and durations are read with
# its ffprobe, so this script measures the shipped binary and not the host's.

require "fileutils"
require "json"
require "net/http"
require "open3"
require "openssl"
require "securerandom"
require "tmpdir"
require "uri"

require_relative "script_support"

# `sh`, `sh!`, `docker_run`, `docker_rm` and `published_port` live in the shared
# plumbing, together with the comments explaining their shapes. What stays here
# is what reads differently in this script than in the others — `check` rescuing
# into a failure, `await_health` dumping diagnostics — and the checks themselves.
include ScriptSupport

IMAGE = ENV.fetch("IMAGE", "audio_proxy:smoke")
REPO_ROOT = File.expand_path("..", __dir__)

# Read out of VERSIONS.md rather than duplicated here, so the pin has one home.
# The `FFMPEG_MAJOR=` line exists precisely to be parsed: an earlier version of
# this matched prose, and there were two spellings of the number in that file,
# so it read the restatement rather than the record.
EXPECTED_FFMPEG_MAJOR = File.read(File.join(REPO_ROOT, "VERSIONS.md"))
  .then { |doc| doc[/^\s*FFMPEG_MAJOR=(\d+)\s*$/, 1] }
  &.to_i

# Hex, because that is what AP_KEY and AP_SALT take. 32 decoded bytes is the
# floor AudioProxy.Config enforces.
KEY = SecureRandom.hex(32)
SALT = SecureRandom.hex(16)

# The store the `s3://` source check runs against. Pinned to the same MinIO
# release CI starts for the `:minio` suite, so the two levels are not testing
# against different stores and calling it one guarantee. `mc` is MinIO's own
# client and is used only to create the bucket and put the fixture — the proxy
# does its own signing, which is the thing under test.
MINIO_IMAGE = "minio/minio:RELEASE.2025-04-22T22-12-26Z"
MC_IMAGE = "minio/mc:RELEASE.2025-04-16T18-13-26Z"
S3_BUCKET = "masters"
# The variant cache's own bucket. Separate from the source bucket on purpose:
# a deployment that shares one would hide a backend writing where it reads.
S3_VARIANT_BUCKET = "variants"
S3_ACCESS_KEY = "minioadmin"
S3_SECRET_KEY = "minioadmin"
# Reached by container alias on a suite-private network, so it is the same
# hostname inside the proxy container and inside `mc`. Path-style addressing
# follows from the custom endpoint by default, which is what MinIO needs —
# `masters.minio` would want DNS nobody configured.
S3_URL = "http://minio:9000"

FIXTURE_SECONDS = 5
# ffmpeg's mp3 encoder pads the last frame, so an exact match is the wrong
# assertion; a tenth of a second is well inside a re-encode and well outside a
# truncated stream.
DURATION_TOLERANCE = 0.15

@failures = []

def log(message) = puts("  #{message}")

def step(name)
  print "→ #{name}\n"
  yield
end

def check(description)
  if yield
    log "✓ #{description}"
  else
    log "✗ #{description}"
    @failures << description
  end
rescue StandardError => e
  log "✗ #{description} (#{e.class}: #{e.message})"
  @failures << description
end

# For the cases that genuinely want both streams — container logs, where the
# BEAM's crash output goes to stderr and its Logger output to stdout, and
# reading only one loses half the story. `sh`, which keeps them apart, is in the
# shared plumbing and explains itself there.
def sh_combined(*args)
  stdout, stderr, status = Open3.capture3(*args)
  [stdout.to_s + stderr.to_s, status.success?]
end

def wait_for_health(port, timeout: 60)
  deadline = Time.now + timeout
  loop do
    body = begin
      Net::HTTP.get(URI("http://127.0.0.1:#{port}/health"))
    rescue StandardError
      nil
    end
    return JSON.parse(body) if body&.start_with?("{")
    return nil if Time.now > deadline

    sleep 0.2
  end
end

# A container that never becomes healthy is the one failure that tells you
# nothing: every later check fails as collateral, and the only visible symptom
# is `docker exec` refusing to talk to a container that is no longer running.
# Whatever the release said on its way down is in its logs, and those are gone
# the moment the container is removed — so print them at the point of failure.
def await_health(cid, port, timeout: 60)
  health = wait_for_health(port, timeout: timeout)
  return health if health

  state = begin
    JSON.parse(sh!("docker", "inspect", cid)).first["State"]
  rescue StandardError
    {}
  end
  logs, _ = sh_combined("docker", "logs", cid)

  log "--- container never became healthy; diagnostics follow ---"
  log "state: running=#{state["Running"].inspect} exit=#{state["ExitCode"].inspect} error=#{state["Error"].inspect}"
  log "health: #{state.dig("Health", "Status").inspect}"
  logs.to_s.lines.last(40).each { |line| log "  | #{line.chomp}" }
  log "--- end diagnostics ---"

  nil
end

# base64url(HMAC-SHA256(key, salt || rest_of_path)), unpadded — the reference
# signer in AudioProxy.Signature, in the language the smoke suite is written in.
# Signing here rather than shelling into the container is the point: it proves a
# third-party client can sign a URL this server accepts.
def sign(rest_of_path, key_hex: KEY, salt_hex: SALT)
  key = [key_hex].pack("H*")
  salt = [salt_hex].pack("H*")
  mac = OpenSSL::HMAC.digest("SHA256", key, salt + rest_of_path)
  [mac].pack("m0").tr("+/", "-_").delete("=")
end

# ---------------------------------------------------------------------------

def build_image
  return log("skipped (SKIP_BUILD)") if ENV["SKIP_BUILD"]

  revision = sh("git", "-C", REPO_ROOT, "rev-parse", "HEAD").first.strip
  version = File.read(File.join(REPO_ROOT, "mix.exs"))[/version:\s*"([^"]+)"/, 1]

  sh!("docker", "build",
      "--build-arg", "VERSION=#{version}",
      "--build-arg", "REVISION=#{revision}",
      "-t", IMAGE, REPO_ROOT)
  log "built #{IMAGE} (version #{version}, revision #{revision[0, 12]})"
end

# The fixture is generated by the image's ffmpeg into a directory that is then
# mounted READ-ONLY for every server container below. That ordering is the
# posture the README tells operators to use, and it is load-bearing: write
# access to AP_LOCAL_ROOT is write access to what the proxy will serve, which is
# the precondition for the hardlink and TOCTOU exposures documented in
# docs/sources.md.
def generate_fixtures(dir)
  # `--user` matters on Linux, where bind-mount ownership is not remapped:
  # without it ffmpeg writes as root, and the chmod below — run as the
  # unprivileged host user — dies with EPERM. macOS remaps ownership and hides
  # this entirely, so it is a CI-only failure that passes locally.
  as_host_user = ["--user", "#{Process.uid}:#{Process.gid}"]

  # The space in the name is deliberate — it is what makes the signed URL below
  # carry a percent-escape.
  sh!("docker", "run", "--rm", *as_host_user, "-v", "#{dir}:/out", "--entrypoint", "ffmpeg", IMAGE,
      "-hide_banner", "-loglevel", "error",
      "-f", "lavfi", "-i", "sine=frequency=440:duration=#{FIXTURE_SECONDS}",
      "-ac", "1", "-ar", "44100", "/out/tone one.wav")

  # A long source, so a render is still in flight when SIGTERM arrives.
  sh!("docker", "run", "--rm", *as_host_user, "-v", "#{dir}:/out", "--entrypoint", "ffmpeg", IMAGE,
      "-hide_banner", "-loglevel", "error",
      "-f", "lavfi", "-i", "sine=frequency=220:duration=900",
      "-ac", "2", "-ar", "48000", "/out/long.wav")

  # Dir.mktmpdir is 0700 and owned by the host user, but the server runs as uid
  # 1000 inside the container. On Linux that uid cannot even traverse the
  # directory, so every render would 404 on a source that is plainly there.
  # World-readable, never world-writable: the point of the mount is that the
  # proxy cannot change what it serves.
  FileUtils.chmod(0o755, dir)
  FileUtils.chmod(0o444, Dir.glob(File.join(dir, "*.wav")))
  log "fixtures: #{Dir.children(dir).sort.join(", ")}"
end

# `--user` for the same reason as in generate_fixtures, from the other side: the
# image's default user is `app` (uid 1000), and the directory being mounted here
# is a 0700 mktmpdir owned by whoever runs this script. On Linux uid 1000 cannot
# traverse it, so ffprobe reports "Permission denied" on a file that is plainly
# there. Running as the host user makes the mount readable by construction.
def probe_duration(path)
  dir = File.dirname(path)
  out = sh!("docker", "run", "--rm", "--user", "#{Process.uid}:#{Process.gid}",
            "-v", "#{dir}:/probe:ro", "--entrypoint", "ffprobe", IMAGE,
            "-v", "error", "-show_entries", "format=duration",
            "-of", "default=nw=1:nk=1", "/probe/#{File.basename(path)}")
  Float(out.strip)
end

def start_server(fixtures, extra_env: {}, docker_args: [])
  env = {
    "AP_LOCAL_ROOT" => "/fixtures",
    "AP_KEY" => KEY,
    "AP_SALT" => SALT
  }.merge(extra_env)

  docker_run(
    *env.flat_map { |k, v| ["-e", "#{k}=#{v}"] },
    "-p", "127.0.0.1::#{extra_env["AP_PORT"] || 4000}",
    "-v", "#{fixtures}:/fixtures:ro",
    *docker_args,
    IMAGE
  )
end

# ---------------------------------------------------------------------------
# Checks
# ---------------------------------------------------------------------------

def check_image_properties
  # Selected by content, not position: docker's own advisories share this stream
  # (see docker_run), so "the first line" is not reliably ffmpeg's banner.
  ffmpeg = sh!("docker", "run", "--rm", "--entrypoint", "ffmpeg", IMAGE, "-version")
    .lines.find { |line| line.start_with?("ffmpeg version") }.to_s
  major = ffmpeg[/ffmpeg version (\d+)/, 1]&.to_i

  check "VERSIONS.md records an expected ffmpeg major" do
    !EXPECTED_FFMPEG_MAJOR.nil?
  end
  check "image ffmpeg is major #{EXPECTED_FFMPEG_MAJOR} (got #{major})" do
    major == EXPECTED_FFMPEG_MAJOR
  end
  check "image ships ffprobe" do
    sh("docker", "run", "--rm", "--entrypoint", "ffprobe", IMAGE, "-version").last
  end

  # No Erlang installed in the runtime stage: the release brings its own ERTS,
  # and finding a system erl here would mean the wrong base image.
  check "runtime stage has no system erlang (ERTS is bundled)" do
    !sh("docker", "run", "--rm", "--entrypoint", "sh", IMAGE, "-c", "command -v erl").last
  end

  # The render lifecycle signals ffmpeg via System.find_executable("kill"),
  # which wants a real binary — `command -v` would find the shell builtin and
  # tell us nothing, so this tests for the file. Alpine's busybox provided one
  # for free and Debian slim does not; without it a disconnect or timeout cannot
  # terminate a render and the no-orphan guarantee quietly stops holding.
  check "image provides the kill binary the render lifecycle needs" do
    sh("docker", "run", "--rm", "--entrypoint", "sh", IMAGE,
       "-c", "test -x /bin/kill || test -x /usr/bin/kill").last
  end

  inspect_out = JSON.parse(sh!("docker", "inspect", IMAGE)).first
  labels = inspect_out.dig("Config", "Labels") || {}

  check "OCI source label identifies the repository" do
    labels["org.opencontainers.image.source"].to_s.include?("audioproxy")
  end
  check "OCI revision label is set" do
    labels["org.opencontainers.image.revision"].to_s.match?(/\A[0-9a-f]{40}\z/)
  end
  check "OCI version label is set" do
    !labels["org.opencontainers.image.version"].to_s.empty?
  end
  check "image declares a healthcheck" do
    !inspect_out.dig("Config", "Healthcheck", "Test").nil?
  end
end

def check_render(fixtures)
  cid = start_server(fixtures, extra_env: {"AP_ALLOW_INSECURE" => "true"})
  port = published_port(cid)

  health = await_health(cid, port)
  check "container reaches /health" do
    health && health["status"] == "ok"
  end
  check "/health reports the release version" do
    health && !health["version"].to_s.empty?
  end
  check "main process runs as a non-root uid" do
    sh!("docker", "exec", cid, "id", "-u").strip != "0"
  end

  Dir.mktmpdir do |out|
    rendered = File.join(out, "rendered.mp3")
    url = "http://127.0.0.1:#{port}/insecure/f:mp3/br:128/plain/local://tone%20one.wav"
    headers, ok = curl(url, rendered)

    check "insecure render answers 200" do
      ok && headers.first.include?("200")
    end
    check "render is chunked with audio/mpeg" do
      headers.any? { |h| h.downcase.start_with?("content-type: audio/mpeg") } &&
        headers.any? { |h| h.downcase.start_with?("transfer-encoding: chunked") }
    end
    check "render is a cache MISS" do
      headers.any? { |h| h.downcase.start_with?("x-audio-proxy: miss") }
    end

    duration = probe_duration(rendered)
    check "rendered duration is #{FIXTURE_SECONDS}s (got #{duration.round(3)})" do
      (duration - FIXTURE_SECONDS).abs <= DURATION_TOLERANCE
    end
  end

  docker_rm(cid)
end

# An `s3://` source, rendered end to end through the shipped image against a
# real store.
#
# This exists because the release gate could not see S3 at all: v0.3.0's notes
# announced S3 rendering while `Source.S3` still answered `no_backend`, and
# every signal was green because the smoke suite rendered `local://` only. A
# claim about S3 now has a check to point at, per docs/development.md's
# "release notes are claims, and claims name their checks".
#
# What only this level can show, and the ExUnit `:minio` suite cannot: the
# ffmpeg *this image ships* opening a presigned URL and ranging it over the
# network. Everything below the URL — signing, addressing, error translation —
# is already pinned by `AudioProxy.S3Test` against the same store.
def check_s3_source(fixtures)
  network = "audio-proxy-smoke-#{SecureRandom.hex(4)}"
  sh!("docker", "network", "create", network)

  minio = docker_run(
    "--network", network, "--network-alias", "minio",
    "-e", "MINIO_ROOT_USER=#{S3_ACCESS_KEY}",
    "-e", "MINIO_ROOT_PASSWORD=#{S3_SECRET_KEY}",
    MINIO_IMAGE, "server", "/data"
  )

  ready = wait_until(timeout: 60) { mc(network, "mc alias set store #{S3_URL} #{S3_ACCESS_KEY} #{S3_SECRET_KEY}") }
  check "MinIO becomes reachable" do
    ready
  end

  # `mc` rather than a hand-rolled SigV4 PUT: signing is `ex_aws`'s job in this
  # project and re-implementing it in the smoke suite would be a second
  # implementation to keep correct, testing itself.
  uploaded = mc(network, <<~SH, mount: fixtures)
    mc alias set store #{S3_URL} #{S3_ACCESS_KEY} #{S3_SECRET_KEY} &&
    mc mb --ignore-existing store/#{S3_BUCKET} &&
    mc cp "/fixtures/tone one.wav" "store/#{S3_BUCKET}/tone one.wav"
  SH
  check "the fixture uploads to the #{S3_BUCKET} bucket" do
    uploaded
  end

  cid = start_server(
    fixtures,
    extra_env: {
      "AP_ALLOW_INSECURE" => "true",
      "AP_S3_ENDPOINT" => S3_URL,
      "AWS_ACCESS_KEY_ID" => S3_ACCESS_KEY,
      "AWS_SECRET_ACCESS_KEY" => S3_SECRET_KEY,
      "AWS_REGION" => "us-east-1"
    },
    docker_args: ["--network", network]
  )
  port = published_port(cid)

  check "container with S3 credentials reaches /health" do
    await_health(cid, port)
  end

  Dir.mktmpdir do |out|
    rendered = File.join(out, "from-s3.mp3")
    url = "http://127.0.0.1:#{port}/insecure/f:mp3/br:128/plain/s3://#{S3_BUCKET}/tone%20one.wav"
    headers, ok = curl(url, rendered)

    check "an s3:// source renders 200" do
      ok && headers.first.include?("200")
    end
    check "the s3:// render is chunked audio/mpeg" do
      headers.any? { |h| h.downcase.start_with?("content-type: audio/mpeg") } &&
        headers.any? { |h| h.downcase.start_with?("transfer-encoding: chunked") }
    end

    # The load-bearing assertion: the bytes came from the object, through a
    # presigned URL the image's own ffmpeg opened. A 200 carrying nothing
    # decodable would pass every check above it.
    duration = probe_duration(rendered)
    check "the s3:// render decodes to #{FIXTURE_SECONDS}s (got #{duration.round(3)})" do
      (duration - FIXTURE_SECONDS).abs <= DURATION_TOLERANCE
    end

    missing = File.join(out, "missing.json")
    headers, = curl("http://127.0.0.1:#{port}/insecure/f:mp3/plain/s3://#{S3_BUCKET}/absent.wav", missing)
    check "a missing object is the blind 404" do
      headers.first.include?("404") && JSON.parse(File.read(missing))["error"] == "not_found"
    end

    # And the row this slice added, demonstrated rather than asserted: with the
    # store gone, no source can be reported as missing — including one nothing
    # has rendered, so nothing in flight can answer it from a linger.
    docker_rm(minio)
    minio = nil

    outage = File.join(out, "outage.json")
    headers, = curl("http://127.0.0.1:#{port}/insecure/f:mp3/plain/s3://#{S3_BUCKET}/unrequested.wav", outage)
    body = begin
      JSON.parse(File.read(outage))
    rescue StandardError
      {}
    end

    check "an unreachable store answers 502, not 404" do
      headers.first.include?("502") && body["error"] == "upstream_unavailable"
    end
    check "the 502 is not cached by an edge" do
      headers.any? { |h| h.downcase.start_with?("cache-control: no-store") }
    end
  end

ensure
  # Both containers come off the network before the network goes, and all of it
  # runs here rather than on the happy path. `docker network rm` refuses while
  # anything is still attached, and `sh` swallows that refusal — so removing the
  # proxy container at the end of the body instead would leak a bridge network
  # on every raise between `start_server` and here. The outer `ensure` reaps the
  # container eventually; nothing reaps the network.
  docker_rm(cid) if cid
  docker_rm(minio) if minio
  sh("docker", "network", "rm", network) if network
end

# The variant cache, end to end through the shipped image and a real store:
# render once, find the bytes in the bucket, get them back without rendering,
# and — after the container that rendered them is gone — get a 302 to the store
# that decodes.
#
# Same reason as check_s3_source: the release gate could not see S3 at all, and
# v0.3.0's notes announced an S3 variant bucket and redirect serving while
# Config still refused `s3://` at boot. Both claims now have a check.
#
# What only this level can show, and the ExUnit `:minio` suite cannot: that the
# cache survives the container. The redirect container is a *second* container
# reading a bucket the first one filled, which is the whole difference between
# this store and the `file://` one.
def check_s3_variant_store(fixtures)
  network = "audio-proxy-smoke-#{SecureRandom.hex(4)}"
  sh!("docker", "network", "create", network)

  minio = docker_run(
    "--network", network, "--network-alias", "minio",
    "-e", "MINIO_ROOT_USER=#{S3_ACCESS_KEY}",
    "-e", "MINIO_ROOT_PASSWORD=#{S3_SECRET_KEY}",
    MINIO_IMAGE, "server", "/data"
  )

  ready = wait_until(timeout: 60) { mc(network, alias_set) }
  check "MinIO becomes reachable" do
    ready
  end

  created = mc(network, "#{alias_set} && mc mb --ignore-existing store/#{S3_VARIANT_BUCKET}")
  check "the #{S3_VARIANT_BUCKET} bucket is created" do
    created
  end

  env = {
    "AP_ALLOW_INSECURE" => "true",
    "AP_S3_ENDPOINT" => S3_URL,
    "AWS_ACCESS_KEY_ID" => S3_ACCESS_KEY,
    "AWS_SECRET_ACCESS_KEY" => S3_SECRET_KEY,
    "AWS_REGION" => "us-east-1",
    "AP_VARIANT_STORE" => "s3://#{S3_VARIANT_BUCKET}"
  }

  path = "/insecure/f:mp3/br:128/plain/local://tone%20one.wav"

  cid = start_server(fixtures, extra_env: env.merge("AP_SERVE_MODE" => "proxy"),
                               docker_args: ["--network", network])
  port = published_port(cid)

  # The boot probe writes and deletes under a reserved prefix, so reaching
  # /health at all is already the bucket proving it accepts writes.
  check "a container with an s3:// variant store reaches /health" do
    await_health(cid, port)
  end

  Dir.mktmpdir do |out|
    miss = File.join(out, "miss.mp3")
    headers, ok = curl("http://127.0.0.1:#{port}#{path}", miss)

    check "the first request renders (MISS, chunked)" do
      ok && headers.first.include?("200") &&
        headers.any? { |h| h.downcase.start_with?("x-audio-proxy: miss") } &&
        headers.any? { |h| h.downcase.start_with?("transfer-encoding: chunked") }
    end

    # The write-back is a subscriber to the render, not part of the response, so
    # it finishes after the last byte reaches the client. Polling the bucket is
    # the honest way to wait for it.
    # `test -n "$(…)"` rather than piping to `grep`: the mc image carries mc, a
    # shell, and very little else — `grep` is not in it, so a grep-based probe
    # fails every poll and reports an empty bucket that is not empty. Caught
    # because the HIT below passed while this said the object had never landed.
    stored = wait_until(timeout: 60) do
      mc(network, %(#{alias_set} > /dev/null && test -n "$(mc ls store/#{S3_VARIANT_BUCKET})"))
    end
    check "the render is teed to the bucket" do
      stored
    end

    hit = File.join(out, "hit.mp3")
    headers, ok = curl("http://127.0.0.1:#{port}#{path}", hit)

    check "the same URL is then a HIT, served from the store" do
      ok && headers.first.include?("200") &&
        headers.any? { |h| h.downcase.start_with?("x-audio-proxy: hit") }
    end
    check "the HIT declares a length and accepts ranges" do
      headers.any? { |h| h.downcase.start_with?("content-length:") } &&
        headers.any? { |h| h.downcase.start_with?("accept-ranges: bytes") }
    end
    check "the HIT is byte-identical to the render it replaced" do
      File.binread(hit) == File.binread(miss)
    end

    duration = probe_duration(hit)
    check "the HIT decodes to #{FIXTURE_SECONDS}s (got #{duration.round(3)})" do
      (duration - FIXTURE_SECONDS).abs <= DURATION_TOLERANCE
    end

    # A second container, same bucket: the cache outliving the process that
    # filled it is the property a `file://` store does not have.
    docker_rm(cid)
    cid = start_server(fixtures, extra_env: env.merge("AP_SERVE_MODE" => "redirect"),
                                 docker_args: ["--network", network])
    port = published_port(cid)

    check "a second container boots in redirect mode against the same store" do
      await_health(cid, port)
    end

    redirected = File.join(out, "redirect.txt")
    headers, = curl("http://127.0.0.1:#{port}#{path}", redirected)
    location = headers.find { |h| h.downcase.start_with?("location:") }&.split(": ", 2)&.last

    check "a HIT in redirect mode is a 302 to the store" do
      headers.first.include?("302") &&
        headers.any? { |h| h.downcase.start_with?("x-audio-proxy: hit") } &&
        location.to_s.start_with?(S3_URL)
    end
    check "the redirect is not cached — its Location expires" do
      headers.any? { |h| h.downcase.start_with?("cache-control: no-store") }
    end

    # Followed from inside the network, because the presigned URL names the
    # store by its container alias. ffprobe rather than curl for a reason
    # beyond convenience: a signed URL that returned an error document would
    # still be a 200 to curl, and a duration cannot be faked by one.
    duration = probe_duration_url(network, location.to_s)
    check "following the Location decodes to #{FIXTURE_SECONDS}s (got #{duration.round(3)})" do
      (duration - FIXTURE_SECONDS).abs <= DURATION_TOLERANCE
    end
  end
ensure
  # Ordering and placement as in check_s3_source: containers off the network
  # before the network goes, all of it here rather than on the happy path.
  docker_rm(cid) if cid
  docker_rm(minio) if minio
  sh("docker", "network", "rm", network) if network
end

# The `mc` preamble every invocation needs, kept in one place because it carries
# the credentials and repeating it invites them drifting apart.
def alias_set = "mc alias set store #{S3_URL} #{S3_ACCESS_KEY} #{S3_SECRET_KEY}"

# ffprobe from a container on the store's network, so a presigned URL naming
# `minio` resolves. The image's own ffprobe, which is the binary under test.
def probe_duration_url(network, url)
  out = sh!("docker", "run", "--rm", "--network", network, "--entrypoint", "ffprobe", IMAGE,
            "-v", "error", "-show_entries", "format=duration",
            "-of", "default=nw=1:nk=1", url)
  Float(out.strip)
end

# One `mc` invocation on the store's network. Returns whether it succeeded, so
# it doubles as the readiness probe: MinIO answering an `alias set` is a better
# "up" signal than a health endpoint that returns before the object API does.
def mc(network, script, mount: nil)
  args = ["docker", "run", "--rm", "--network", network]
  args += ["-v", "#{mount}:/fixtures:ro"] if mount
  args += ["--entrypoint", "sh", MC_IMAGE, "-c", script]

  sh(*args).last
end

# The `:ro` flag is the documented posture, and it has to be tested by something
# that would otherwise succeed. Doing this from the server container proves
# nothing: it runs as uid 1000 against a directory owned by the host user, so
# the write fails on permissions whether or not the mount is read-only, and the
# check passes with the flag removed.
#
# Running as root with the same mount is the discriminating test — root defeats
# the file mode, so a refused write can only be the mount.
def check_readonly_mount(fixtures)
  writable = sh("docker", "run", "--rm", "--user", "0:0",
                "-v", "#{fixtures}:/fixtures:ro", "--entrypoint", "sh", IMAGE,
                "-c", "touch /fixtures/probe").last

  check "a :ro mount refuses a write even from root" do
    !writable && !File.exist?(File.join(fixtures, "probe"))
  end

  # The control: the same command against the same directory mounted rw must
  # succeed. Without it, a check that "fails to write" proves nothing — a typo
  # in the command would look identical to a working guarantee.
  rw_ok = sh("docker", "run", "--rm", "--user", "0:0",
             "-v", "#{fixtures}:/fixtures", "--entrypoint", "sh", IMAGE,
             "-c", "touch /fixtures/probe && rm /fixtures/probe")[1]

  check "the same write succeeds when the mount is writable (control)" do
    rw_ok
  end
end

# Bandit builds request_path separately on its HTTP/2 path, so the signed-bytes
# guarantee the :integration suite pins for HTTP/1.1 has to be re-checked here.
# The escape is real: the source is `local://tone one.wav`, and the signature
# covers the still-escaped `tone%20one.wav`.
def check_signed_h2c(fixtures)
  cid = start_server(fixtures)
  port = published_port(cid)
  check "signed-mode container reaches /health" do
    await_health(cid, port)
  end

  rest = "/f:mp3/br:128/plain/local://tone%20one.wav"
  signed = "http://127.0.0.1:#{port}/#{sign(rest)}#{rest}"

  Dir.mktmpdir do |out|
    rendered = File.join(out, "h2c.mp3")
    version, status = curl_h2c(signed, rendered)

    check "percent-escaped signed URL renders over h2c (HTTP/#{version}, #{status})" do
      version == "2" && status == "200"
    end
    check "h2c render decodes to #{FIXTURE_SECONDS}s" do
      (probe_duration(rendered) - FIXTURE_SECONDS).abs <= DURATION_TOLERANCE
    end

    # Same path, wrong key: the signature is what is being tested, not the path.
    bad = "http://127.0.0.1:#{port}/#{sign(rest, key_hex: SecureRandom.hex(32))}#{rest}"
    _, status = curl_h2c(bad, File.join(out, "rejected"))
    check "a signature from the wrong key is 401 over h2c (got #{status})" do
      status == "401"
    end

    # AP_ALLOW_INSECURE is off here, so the escape hatch must be shut.
    _, status = curl_h2c("http://127.0.0.1:#{port}/insecure#{rest}", File.join(out, "insecure"))
    check "insecure segment is 401 when AP_ALLOW_INSECURE is unset (got #{status})" do
      status == "401"
    end
  end

  docker_rm(cid)
end

def check_config(fixtures)
  # An env change with no rebuild has to take effect. AP_PORT is the one
  # variable whose effect is observable from outside today — the others are
  # parsed and validated but not yet consumed (see the README's config table).
  cid = start_server(fixtures, extra_env: {"AP_PORT" => "8123", "AP_ALLOW_INSECURE" => "true"})
  port = published_port(cid, 8123)
  check "AP_PORT override takes effect without a rebuild" do
    await_health(cid, port)
  end
  check "healthcheck follows AP_PORT" do
    # The HEALTHCHECK reads AP_PORT before PORT; if it did not, the container
    # would never leave "starting".
    deadline = Time.now + 90
    status = nil
    loop do
      status = JSON.parse(sh!("docker", "inspect", cid)).first.dig("State", "Health", "Status")
      break if status == "healthy" || Time.now > deadline

      sleep 1
    end
    status == "healthy"
  end
  docker_rm(cid)

  # A malformed AP_ variable must kill the container loudly rather than boot
  # with a surprising default. Run detached and bounded: a container that boots
  # anyway has to fail this check, not hang the suite in the foreground.
  code, out = run_until_exit({"AP_KEY" => "not-hex"})
  check "malformed AP_KEY exits nonzero (got #{code.inspect})" do
    code.is_a?(Integer) && code != 0
  end
  check "malformed AP_KEY names the variable in its error" do
    out.include?("AP_KEY")
  end

  code, out = run_until_exit({"AP_LOCAL_ROOT" => "/"})
  check "AP_LOCAL_ROOT=/ is refused at boot (got #{code.inspect})" do
    code.is_a?(Integer) && code != 0 && out.include?("AP_LOCAL_ROOT")
  end
end

# Starts a container expected to exit on its own and returns [exit_code, logs].
# The exit code is nil when it was still running at the deadline — which is the
# regression this guards against, so the caller must treat nil as a failure.
def run_until_exit(env, timeout: 30)
  cid = docker_run(*env.flat_map { |k, v| ["-e", "#{k}=#{v}"] }, IMAGE)
  code = nil
  wait_until(timeout: timeout) do
    state = JSON.parse(sh!("docker", "inspect", cid)).first["State"]
    code = state["ExitCode"] unless state["Running"]
    !state["Running"]
  end
  logs, _ = sh_combined("docker", "logs", cid)
  docker_rm(cid)
  [code, logs]
end

# SIGTERM while a render streams. The container shares a PID namespace, so once
# PID 1 exits nothing can survive it — "no orphan in the final process table" is
# true by construction and worth nothing as an assertion. What is worth
# something is that ffmpeg is gone from the table *before* the container exits,
# which is the supervisor having killed it rather than the namespace teardown
# doing it, and that the exit is prompt.
def check_sigterm(fixtures)
  cid = start_server(fixtures, extra_env: {"AP_ALLOW_INSECURE" => "true", "AP_RENDER_TIMEOUT" => "600"})
  port = published_port(cid)
  check "container is healthy before SIGTERM" do
    await_health(cid, port)
  end

  # Start a long render and walk away from it — the client never reads the body,
  # so ffmpeg is still encoding when the signal lands.
  url = "http://127.0.0.1:#{port}/insecure/f:mp3/br:320/plain/local://long.wav"
  reader = IO.popen(["curl", "-s", "--max-time", "120", "-o", "/dev/null", url], err: :close)

  begin
    ffmpeg_running = wait_until(timeout: 30) do
      (container_processes(cid) || []).any? { |p| p.include?("ffmpeg") }
    end
    check "ffmpeg is in flight when the signal is sent" do
      ffmpeg_running
    end

    sent_at = Time.now
    sh!("docker", "kill", "--signal=TERM", cid)

    # Poll the process table until ffmpeg leaves it or the container goes away.
    #
    # `observed_table` starts false and is only set once a `docker top` actually
    # came back: if the container vanishes before the first poll we saw nothing,
    # and the check below must fail rather than credit an observation that never
    # happened. An earlier version treated "container already gone" as a pass,
    # which made the whole check satisfiable without ever looking.
    ffmpeg_gone_before_exit = false
    observed_table = false
    while Time.now - sent_at < 20
      procs = container_processes(cid)
      break if procs.nil?

      observed_table = true
      if procs.none? { |p| p.include?("ffmpeg") }
        ffmpeg_gone_before_exit = true
        break
      end
      sleep 0.05
    end

    exited = wait_until(timeout: 20) do
      JSON.parse(sh!("docker", "inspect", cid)).first.dig("State", "Running") == false
    end
    elapsed = Time.now - sent_at
    state = JSON.parse(sh!("docker", "inspect", cid)).first["State"]

    check "container exits after SIGTERM (took #{elapsed.round(2)}s)" do
      exited
    end
    # `docker kill --signal=TERM` applies no grace period of its own — nothing
    # will SIGKILL this container, so a beam that ignored the signal would hang
    # rather than be cut off. The bound is therefore about promptness, not about
    # beating a deadline: an idle container exits in ~1s and one mid-render in
    # ~3s, so 15s is loose enough to survive a loaded CI runner and tight enough
    # that "waits for the 900-second render to finish" cannot pass.
    check "exit is prompt rather than waiting out the in-flight render" do
      elapsed < 15
    end
    check "exit code is a clean shutdown (got #{state["ExitCode"]})" do
      [0, 143].include?(state["ExitCode"])
    end
    check "ffmpeg left the process table before the container exited" do
      observed_table && ffmpeg_gone_before_exit
    end
  ensure
    # The curl client outlives an exception here otherwise; --max-time would
    # eventually reap it, but "eventually" is not cleanup.
    begin
      Process.kill("TERM", reader.pid)
    rescue StandardError
      nil
    end
    begin
      reader.close
    rescue StandardError
      nil
    end
  end

  docker_rm(cid)
end

# The container's process table, or nil once the container is gone — which is
# the distinction check_sigterm turns on, so the two cases must not collapse.
# `docker top` is called without ps arguments on purpose: the daemon parses the
# output and rejects formats that drop the PID column.
def container_processes(cid)
  out, ok = sh("docker", "top", cid)
  ok ? out.lines.drop(1).map(&:strip).reject(&:empty?) : nil
end

def wait_until(timeout:)
  deadline = Time.now + timeout
  loop do
    return true if yield
    return false if Time.now > deadline

    sleep 0.2
  end
end

def curl(url, out_path)
  headers_file = "#{out_path}.headers"
  _, ok = sh("curl", "-s", "--max-time", "120", "-D", headers_file, "-o", out_path, url)
  [File.readlines(headers_file).map(&:chomp), ok]
end

def curl_h2c(url, out_path)
  out, _ = sh("curl", "-s", "--http2-prior-knowledge", "--max-time", "120",
              "-o", out_path, "-w", "%{http_version} %{http_code}", url)
  out.split.last(2)
end

# ---------------------------------------------------------------------------

begin
  step("build") { build_image }
  step("image properties") { check_image_properties }

  Dir.mktmpdir("audio-proxy-smoke") do |fixtures|
    step("fixtures") { generate_fixtures(fixtures) }
    step("render (insecure, read-only mount)") { check_render(fixtures) }
    step("render from an s3:// source") { check_s3_source(fixtures) }
    step("s3:// variant store, proxied and redirected") { check_s3_variant_store(fixtures) }
    step("read-only fixture mount") { check_readonly_mount(fixtures) }
    step("signed URL over h2c") { check_signed_h2c(fixtures) }
    step("runtime configuration") { check_config(fixtures) }
    step("SIGTERM during a render") { check_sigterm(fixtures) }
  end
ensure
  containers.dup.each { |cid| docker_rm(cid) }
end

puts
if @failures.empty?
  puts "smoke: all checks passed"
  exit 0
else
  puts "smoke: #{@failures.length} check(s) failed"
  @failures.each { |f| puts "  - #{f}" }
  exit 1
end
