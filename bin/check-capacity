#!/usr/bin/env ruby
# frozen_string_literal: true

# The drift guard for docs/capacity.md: drives a concurrent workload — including
# a two-hour source — through the release container and fails if its cgroup
# memory.peak exceeds what the published model predicts for that configuration.
#
#   bin/check-capacity                  # build, then run the guard
#   SKIP_BUILD=1 bin/check-capacity     # reuse the tagged image
#   SKIP_BUILD=1 bin/check-capacity --self-test   # prove the guard can fail
#
# Requires docker and a cgroup v2 host (`memory.peak`, kernel >= 5.19). ffmpeg
# is not needed on the host: fixtures are generated by the image's own ffmpeg.
#
# ## What is actually being asserted
#
# Not "memory stayed under a number somebody picked" — that is a smoke test with
# extra steps. The prediction is computed here from the same formula
# docs/capacity.md publishes, over the configuration this script hands the
# container, using `R_ffmpeg` values **parsed out of that document's table**. So
# the guard fails in exactly two situations, and both are the ones worth
# catching:
#
#   * a change grows a memory term the model does not have (an uncapped
#     retention path, a bigger buffer, a per-subscriber copy that used to be
#     shared), or
#   * the published table has drifted from the ffmpeg the image now ships.
#
# ## Two adjustments, both stated rather than hidden
#
# `BEAM_base` is measured rather than assumed: the container's memory.peak is
# read once it is healthy and idle, and the workload's prediction is built on top
# of that. A guard carrying a hardcoded base is a guard that silently absorbs
# base growth.
#
# `memory.peak` counts page cache, and a `local://` workload reads its source
# files through it — hundreds of megabytes of reclaimable cache that is not the
# proxy's working set and that the kernel drops under pressure rather than
# OOM-killing for. `inactive_file` from `memory.stat` is subtracted from the
# observed peak before the comparison. It is an approximation (the cache
# resident at the end is not exactly the cache resident at the peak), which is
# part of what HEADROOM covers.

require "json"
require "net/http"
require "open3"
require "optparse"
require "tmpdir"
require "uri"

IMAGE = ENV.fetch("IMAGE", "audio_proxy:runtime")
REPO_ROOT = File.expand_path("..", __dir__)
CAPACITY_DOC = File.join(REPO_ROOT, "docs", "capacity.md")

# The configuration the workload runs under. Small on purpose: the guard is
# about the model's shape, and four slots exercise every term while keeping a
# CI runner's peak inside what a runner has.
MAX_CONCURRENCY = 4

# Two hours, the case the model has the most to be wrong about. 64 kbps mono
# keeps the fixture at ~57 MB on disk while still being two hours of audio to
# decode — the model has no source-size term, and this is where that claim is
# either true or is not.
LONG_SECONDS = 7200
LONG_BITRATE = "64k"
SHORT_SECONDS = 30

# The workload: every slot busy with a full-length render, plus short renders
# competing for the same slots. Distinct trim windows so no two requests share a
# cache key — coalescing is a real feature, and it would quietly turn eight
# requests into one render and measure nothing.
LONG_REQUESTS = MAX_CONCURRENCY
SHORT_REQUESTS = 8

# The lowest output bitrate the long requests use, in kbps; each subsequent one
# is a kbps higher, which is what makes their cache keys distinct.
BASE_BITRATE_KBPS = 128

# Applied to the prediction before comparing. Covers BEAM allocator slack (freed
# binaries are returned to the OS lazily), refc-binary collection lag, the
# page-cache approximation above, and arm64-measured figures being checked on
# amd64. Stated in docs/capacity.md too — a tolerance nobody can find is a
# tolerance nobody can argue with.
HEADROOM = 1.5

# `@linger` in AudioProxy.RenderCoordinator is 1 s, and a completed render holds
# its whole backlog for that second having already released its slot. Renders
# here take tens of seconds, so at most about one extra backlog is resident.
LINGER_BACKLOGS = 1

# `@high_water` in AudioProxy.Ffmpeg.Render.
HIGH_WATER = 1 * 1024 * 1024

MIB = 1_048_576.0

@containers = []
@failures = []

def log(message) = puts("  #{message}")

def step(name)
  puts "→ #{name}"
  yield
end

def sh(*args)
  stdout, stderr, status = Open3.capture3(*args)
  @last_stderr = stderr
  [stdout, status.success?]
end

def sh!(*args)
  out, ok = sh(*args)
  raise "command failed: #{args.join(" ")}\n#{out}#{@last_stderr}" unless ok

  out
end

def docker_run(*args)
  out = sh!("docker", "run", "-d", *args)
  cid = out.lines.map(&:strip).reverse.find { |line| line.match?(/\A[0-9a-f]{64}\z/) }
  raise "no container id in docker run output:\n#{out}" unless cid

  @containers << cid
  cid
end

def docker_rm(cid)
  sh("docker", "rm", "-f", cid)
  @containers.delete(cid)
end

def mib(bytes) = (bytes / MIB).round(1)

# ---------------------------------------------------------------------------
# The model
# ---------------------------------------------------------------------------

# `R_ffmpeg`, read out of the published table rather than restated here — so a
# table that has drifted from the shipped ffmpeg fails this guard rather than
# quietly under-predicting.
#
# Only the `+ norm` rows are dropped: this workload applies no filter, and
# including them would predict against a filter cost nothing here pays. The
# long-form rows stay, being plain renders and the largest plain figures in the
# table, which is what a worst case wants.
def published_rss
  doc = File.read(CAPACITY_DOC)
  table = doc[/<!-- rss-table:begin -->(.*?)<!-- rss-table:end -->/m, 1].to_s

  rows = table.lines.filter_map do |line|
    cells = line.split("|").map(&:strip)
    next unless cells.length >= 5

    label, _options, _source, rss = cells[1], cells[2], cells[3], cells[4]
    next if label.include?("norm") || label.include?("Variant") || label.start_with?("-")

    mibs = rss.gsub("*", "")[/([\d.]+)\s*MiB/, 1]
    next unless mibs

    [label, Float(mibs) * MIB]
  end

  raise "no usable rows in the #{CAPACITY_DOC} table — run bin/measure-ffmpeg-rss" if rows.empty?

  rows.to_h
end

# `T_ffmpeg`: the shared library text one ffmpeg makes resident. Measured rather
# than carried as a constant, and measured as the gap between what a container
# running one ffmpeg peaks at and the anonymous memory that ffmpeg privately
# held — which is exactly the file-backed residency the model pays once.
#
# It has to be in the prediction because it is unavoidably in the observation:
# `BEAM_base` is read from an idle container that has never run a render, and
# `R_ffmpeg` is anonymous-only by construction, so without this term the
# prediction is short by the whole of libavcodec.
def measure_ffmpeg_text
  probe = <<~SH
    : > /tmp/anon
    awk '$1 == "anon" {print $2}' /sys/fs/cgroup/memory.stat >> /tmp/anon
    while :; do
      awk '$1 == "anon" {print $2}' /sys/fs/cgroup/memory.stat >> /tmp/anon
      sleep 0.02
    done &
    sampler=$!

    ffmpeg -hide_banner -loglevel error -f lavfi -i sine=duration=20 \
      -vn -c:a libmp3lame -f mp3 pipe:1 > /dev/null 2>&1
    kill "$sampler" 2>/dev/null

    echo "anon=$(sort -n /tmp/anon | tail -1)"
    echo "peak=$(cat /sys/fs/cgroup/memory.peak)"
  SH

  out = sh!("docker", "run", "--rm", "--cgroupns=private",
            "--entrypoint", "sh", IMAGE, "-c", probe)
  fields = out.lines.map(&:chomp)
  anon = Integer(fields.find { |l| l.start_with?("anon=") }.delete_prefix("anon="))
  peak = Integer(fields.find { |l| l.start_with?("peak=") }.delete_prefix("peak="))

  [peak - anon, 0].max
end

# The formula from docs/capacity.md, over this workload's configuration.
#
# `B_backlog` is the *largest* variant the workload produces, and every slot is
# assumed to hold one: a worst case is what belongs in a memory limit, and the
# whole point of the guard is to check the worst case rather than the average.
def predict(beam_base:, ffmpeg_text:, rss_table:, backlog_bytes:, concurrency:)
  r_ffmpeg = rss_table.values.max
  per_render = r_ffmpeg + backlog_bytes + HIGH_WATER
  renders = concurrency + LINGER_BACKLOGS

  {
    total: beam_base + ffmpeg_text + (renders * per_render),
    beam_base: beam_base,
    ffmpeg_text: ffmpeg_text,
    r_ffmpeg: r_ffmpeg,
    backlog: backlog_bytes,
    renders: renders
  }
end

# ---------------------------------------------------------------------------
# Container plumbing
# ---------------------------------------------------------------------------

def generate_fixtures(dir)
  as_host_user = ["--user", "#{Process.uid}:#{Process.gid}"]

  # Compressed, so two hours of audio is a fixture a CI runner can hold. It is
  # also the more honest input: a real source is a file ffmpeg decodes, not raw
  # PCM it copies.
  sh!("docker", "run", "--rm", *as_host_user, "-v", "#{dir}:/out", "--entrypoint", "ffmpeg", IMAGE,
      "-hide_banner", "-loglevel", "error",
      "-f", "lavfi", "-i", "sine=frequency=220:duration=#{LONG_SECONDS}",
      "-ac", "1", "-ar", "44100", "-b:a", LONG_BITRATE, "/out/long.mp3")

  sh!("docker", "run", "--rm", *as_host_user, "-v", "#{dir}:/out", "--entrypoint", "ffmpeg", IMAGE,
      "-hide_banner", "-loglevel", "error",
      "-f", "lavfi", "-i", "sine=frequency=440:duration=#{SHORT_SECONDS}",
      "-ac", "2", "-ar", "44100", "/out/short.wav")

  File.chmod(0o755, dir)
  Dir.glob(File.join(dir, "*")).each { |f| File.chmod(0o444, f) }
  log "fixtures: #{Dir.children(dir).sort.join(", ")} " \
      "(#{Dir.children(dir).sum { |f| File.size(File.join(dir, f)) } / 1_000_000} MB)"
end

def start_server(fixtures)
  cid = docker_run(
    "--cgroupns=private",
    "-e", "AP_LOCAL_ROOT=/fixtures",
    "-e", "AP_ALLOW_INSECURE=true",
    "-e", "AP_MAX_CONCURRENCY=#{MAX_CONCURRENCY}",
    # Above the largest source and the largest variant, so the cap is not what
    # this run is testing. The retention path has its own tests; the guard is
    # about the model holding when nothing trips.
    "-e", "AP_MAX_SRC_BYTES=4000000000",
    "-e", "AP_RENDER_TIMEOUT=900",
    "-p", "127.0.0.1::4000",
    "-v", "#{fixtures}:/fixtures:ro",
    IMAGE
  )
  [cid, published_port(cid)]
end

def published_port(cid, container_port = 4000)
  ports = JSON.parse(sh!("docker", "inspect", cid)).first.dig("NetworkSettings", "Ports")
  binding = ports["#{container_port}/tcp"]&.first
  raise "container #{cid} published no host port for #{container_port}" unless binding

  Integer(binding["HostPort"])
end

def await_health(cid, port, timeout: 90)
  deadline = Time.now + timeout
  loop do
    body = begin
      Net::HTTP.get(URI("http://127.0.0.1:#{port}/health"))
    rescue StandardError
      nil
    end
    return JSON.parse(body) if body&.start_with?("{")

    if Time.now > deadline
      logs, = sh("docker", "logs", cid)
      log "container never became healthy; last lines follow"
      logs.to_s.lines.last(20).each { |l| log "  | #{l.chomp}" }
      return nil
    end

    sleep 0.2
  end
end

def cgroup(cid)
  out = sh!("docker", "exec", cid, "sh", "-c",
            "echo peak=$(cat /sys/fs/cgroup/memory.peak); " \
            "grep -E '^(inactive_file|anon|file) ' /sys/fs/cgroup/memory.stat")
  fields = out.lines.map(&:chomp)
  {
    peak: Integer(fields.find { |l| l.start_with?("peak=") }.delete_prefix("peak=")),
    inactive_file: Integer(fields.find { |l| l.start_with?("inactive_file ") }.split.last),
    anon: Integer(fields.find { |l| l.start_with?("anon ") }.split.last),
    file: Integer(fields.find { |l| l.start_with?("file ") }.split.last)
  }
end

# ---------------------------------------------------------------------------
# The workload
# ---------------------------------------------------------------------------

# Distinct `t:` windows so every request is its own cache key. Two requests that
# coalesce cost one backlog between them, which is a property worth having and a
# workload worth not accidentally running.
def workload_urls(port)
  base = "http://127.0.0.1:#{port}/insecure"

  long = Array.new(LONG_REQUESTS) do |i|
    "#{base}/f:mp3/br:#{BASE_BITRATE_KBPS + i}/plain/local://long.mp3"
  end

  short = Array.new(SHORT_REQUESTS) do |i|
    "#{base}/f:flac/t:#{i}:#{SHORT_SECONDS - i - 1}/plain/local://short.wav"
  end

  long + short
end

# Every request in flight at once, bodies discarded. Discarding is deliberate:
# a client that reads promptly lets the coordinator's backlog be the only copy,
# which is the term being measured. Returns the HTTP status of each.
def drive(urls, timeout:)
  urls.map do |url|
    Thread.new do
      out, = sh("curl", "-s", "-o", "/dev/null", "--max-time", timeout.to_s,
                "-w", "%{http_code}", url)
      out.strip
    end
  end.map(&:value)
end

# The largest variant the workload produces, which is what `B_backlog` is in the
# prediction. Computed from the bitrate and duration rather than read back, so
# the guard states a bound rather than blessing whatever happened. `br` is in
# kbps, and the workload's highest is the last of the distinct rates above.
def largest_variant_bytes
  (BASE_BITRATE_KBPS + LONG_REQUESTS - 1) * 1000 * LONG_SECONDS / 8
end

# ---------------------------------------------------------------------------

def run_guard(self_test:)
  rss_table = published_rss
  log "published R_ffmpeg: #{rss_table.map { |k, v| "#{k} #{mib(v)}" }.join(", ")} MiB"

  ffmpeg_text = measure_ffmpeg_text
  log "measured T_ffmpeg: #{mib(ffmpeg_text)} MiB of shared library text"

  Dir.mktmpdir("audio-proxy-capacity") do |fixtures|
    step("fixtures") { generate_fixtures(fixtures) }

    cid, port = nil
    step("container") do
      cid, port = start_server(fixtures)
      raise "container never became healthy" unless await_health(cid, port)

      log "healthy on port #{port}, AP_MAX_CONCURRENCY=#{MAX_CONCURRENCY}"
    end

    # Page cache is stripped here for the same reason it is stripped from the
    # observation below — the two numbers have to be on the same scale, or the
    # prediction quietly carries 50 MiB of boot-time cache the comparison has
    # already subtracted from the other side.
    idle = cgroup(cid)
    beam_base = idle[:peak] - idle[:inactive_file]
    log "idle peak #{mib(idle[:peak])} MiB − #{mib(idle[:inactive_file])} MiB cache " \
        "= #{mib(beam_base)} MiB — this is BEAM_base"

    statuses = nil
    elapsed = nil
    step("workload: #{LONG_REQUESTS} × #{LONG_SECONDS / 3600}h + #{SHORT_REQUESTS} × #{SHORT_SECONDS}s, all concurrent") do
      started = Time.now
      statuses = drive(workload_urls(port), timeout: 900)
      elapsed = Time.now - started
      log "statuses: #{statuses.tally.map { |c, n| "#{n}×#{c}" }.join(" ")} in #{elapsed.round}s"
    end

    observed = cgroup(cid)

    # A workload that 500s renders nothing and measures nothing, so the guard
    # would pass on a completely broken build. Assert the work happened first.
    check "every request succeeded" do
      statuses.all? { |s| s == "200" }
    end

    # The prediction. In self-test mode it is built for a single slot while the
    # container really ran four — a deliberate under-prediction standing in for
    # a retention path the model does not know about, which the guard has to
    # notice. See --self-test.
    concurrency = self_test ? 1 : MAX_CONCURRENCY
    prediction = predict(
      beam_base: beam_base,
      ffmpeg_text: ffmpeg_text,
      rss_table: rss_table,
      backlog_bytes: largest_variant_bytes,
      concurrency: concurrency
    )

    adjusted = observed[:peak] - observed[:inactive_file]
    bound = prediction[:total] * HEADROOM

    puts
    log "BEAM_base (measured)   #{mib(prediction[:beam_base]).to_s.rjust(8)} MiB"
    log "T_ffmpeg (measured)    #{mib(prediction[:ffmpeg_text]).to_s.rjust(8)} MiB, once"
    log "R_ffmpeg (published)   #{mib(prediction[:r_ffmpeg]).to_s.rjust(8)} MiB × #{prediction[:renders]} renders"
    log "B_backlog              #{mib(prediction[:backlog]).to_s.rjust(8)} MiB × #{prediction[:renders]} renders"
    log "H_pipeline             #{mib(HIGH_WATER).to_s.rjust(8)} MiB × #{prediction[:renders]} renders"
    log "predicted              #{mib(prediction[:total]).to_s.rjust(8)} MiB"
    log "bound (× #{HEADROOM})          #{mib(bound).to_s.rjust(8)} MiB"
    puts
    log "observed memory.peak   #{mib(observed[:peak]).to_s.rjust(8)} MiB"
    log "− inactive_file        #{mib(observed[:inactive_file]).to_s.rjust(8)} MiB (reclaimable page cache)"
    log "adjusted               #{mib(adjusted).to_s.rjust(8)} MiB"
    log "headroom used          #{((adjusted / prediction[:total].to_f) * 100).round}% of the prediction"
    puts

    within = adjusted <= bound
    docker_rm(cid)

    within
  end
end

def check(description)
  if yield
    log "✓ #{description}"
  else
    log "✗ #{description}"
    @failures << description
  end
end

# ---------------------------------------------------------------------------

self_test = false
OptionParser.new do |o|
  o.banner = "usage: bin/check-capacity [--self-test]"
  o.on("--self-test", "assert the guard fails against a deliberate under-prediction") do
    self_test = true
  end
end.parse!

unless ENV["SKIP_BUILD"]
  step("build") { sh!("docker", "build", "--target", "runtime", "-t", IMAGE, REPO_ROOT) }
end

begin
  within = run_guard(self_test: self_test)
ensure
  @containers.dup.each { |cid| docker_rm(cid) }
end

puts
if self_test
  # The red path. The same workload is measured against a prediction built for
  # one concurrent render instead of four — the arithmetic a model that had lost
  # track of a retention term would produce. If the guard still passes, its
  # tolerance has swallowed a 4× error and it would not catch a real one either.
  if within
    puts "capacity self-test: FAILED — a 4× under-prediction still passed; the guard has no teeth"
    exit 1
  end

  puts "capacity self-test: passed (the guard rejects a 4× under-prediction)"
  exit 0
end

check("observed memory is within the model's bound") { within }

if @failures.empty?
  puts "capacity: the model holds"
  exit 0
else
  puts "capacity: #{@failures.length} check(s) failed"
  @failures.each { |f| puts "  - #{f}" }
  puts
  puts "This means docs/capacity.md no longer describes the code. Reconcile the two —"
  puts "widening HEADROOM is not the fix."
  exit 1
end
