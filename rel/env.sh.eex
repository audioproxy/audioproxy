#!/bin/sh

# The proxy is stateless and shares nothing between nodes: no clustering, no
# remote calls, no distributed registry. Running the release as a
# non-distributed node keeps epmd out of the image, leaves port 4369 unbound,
# and removes the cookie from the set of things an operator has to manage.
#
# `bin/audio_proxy remote` and `rpc` need distribution and so do not work here.
# Turning it back on for debugging is a deliberate act: set RELEASE_DISTRIBUTION
# and RELEASE_NODE in the environment, which override what is exported below.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
