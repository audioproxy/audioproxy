# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
audio_proxy-*.tar

# Temporary files, for example, from tests.
/tmp/

# Local, per-machine environment overrides for the AP_* config vars.
.env
.env.*
!.env.example

# Machine-local Claude Code settings.
/.claude/settings.local.json

# Second-opinion review working log (session artifact).
/second-opinion.md

# Browser-automation scratch: the console logs and page snapshots the Playwright
# MCP server drops in the working directory. Artifacts of having looked at a
# page, never an input to anything — and a `git add -A` swept two batches of
# them into archive commits before this line existed.
/.playwright-mcp/

# macOS Finder metadata
.DS_Store

# Local Netlify folder
.netlify
